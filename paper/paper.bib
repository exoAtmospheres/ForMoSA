@article{zucker_cross-correlation_2003,
    abstract = {This paper presents a new approach to combining cross-correlation functions. The combination is based on a maximum-likelihood approach and uses a non-linear combination scheme. It can be effective for radial velocity analysis of multi-order spectra, or for analysis of multiple exposures of the same object. Simulations are presented to show the potential of the suggested combination scheme. The technique has already been used to detect a very faint companion of HD 41004.},
    author = {Zucker, S.},
    doi = {10.1046/j.1365-8711.2003.06633.x},
    file = {Full Text PDF:/home/mravet/Zotero/storage/EX5IBLRZ/Zucker - 2003 - Cross-correlation and maximum-likelihood analysis.pdf:application/pdf},
    issn = {0035-8711},
    journal = {Monthly Notices of the Royal Astronomical Society},
    keywords = {Astrophysics, methods: data analysis, methods: statistical, techniques: radial velocities, techniques: spectroscopic},
    month = jul,
    note = {Publisher: OUP
ADS Bibcode: 2003MNRAS.342.1291Z},
    pages = {1291--1298},
    shorttitle = {Cross-correlation and maximum-likelihood analysis},
    title = {Cross-correlation and maximum-likelihood analysis: a new approach to combining cross-correlation functions},
    url = {https://ui.adsabs.harvard.edu/abs/2003MNRAS.342.1291Z},
    urldate = {2024-11-26},
    volume = {342},
    year = {2003}
}

